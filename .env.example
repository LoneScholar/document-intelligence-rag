# Environment Configuration for Enterprise Financial Document Intelligence RAG

# SEC EDGAR Ingestion Settings
# SEC requires identifying User-Agent: "Sample Company Name AdminContact@<sample company domain>.com"
SEC_EDGAR_USER_AGENT=FinancialAnalystAI admin@example.com

# Vector Store (Qdrant)
# Leave QDRANT_URL empty to use local embedded storage at data/qdrant_db
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sec_10k_filings

# Embedding Model (FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# FlashRank Reranker Model
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# Two-Tier Caching
CACHE_SEMANTIC_THRESHOLD=0.95
CACHE_MAX_ENTRIES=10000

# LLM Provider Configuration
# Options: "gemini", "openai", "ollama", "mistral-local", "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# App & API Settings
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
