  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Prepare ChatML Instruction Dataset\n",
    "Loads the financial instruction dataset or generates synthetic SEC 10-K training pairs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from datasets import Dataset\n",
    "\n",
    "# Sample grounded 10-K instruction pairs\n",
    "training_data = [\n",
    "    {\n",
    "        \"messages\": [\n",
    "            {\"role\": \"system\", \"content\": \"You are an elite, SEC-compliant Financial Document Intelligence AI Assistant. Rely strictly on provided excerpts and include mandatory [Ticker, Year, Section] citations. If disclosures are insufficient, refuse.\"},\n",
    "            {\"role\": \"user\", \"content\": \"EXCERPTS FROM VERIFIED SEC 10-K FILINGS:\\nCitation Anchor: [NVDA, 2024, ITEM 1A. RISK FACTORS]\\nContent:\\nWe rely on third-party foundry partners, primarily Taiwan Semiconductor Manufacturing Company (TSMC), to manufacture all of our semiconductor wafers.\\n\\nUSER QUERY:\\nWhat is NVIDIA's main foundry risk in fiscal 2024?\"},\n",
    "            {\"role\": \"assistant\", \"content\": \"In fiscal year 2024, NVIDIA relies exclusively on Taiwan Semiconductor Manufacturing Company (TSMC) to manufacture all of its semiconductor wafers, creating significant foundry concentration risk [NVDA, 2024, ITEM 1A. RISK FACTORS].\"}\n",
    "        ]\n",
    "    },\n",
    "    {\n",
    "        \"messages\": [\n",
    "            {\"role\": \"system\", \"content\": \"You are an elite, SEC-compliant Financial Document Intelligence AI Assistant. Rely strictly on provided excerpts and include mandatory [Ticker, Year, Section] citations. If disclosures are insufficient, refuse.\"},\n",
    "            {\"role\": \"user\", \"content\": \"EXCERPTS FROM VERIFIED SEC 10-K FILINGS:\\nCitation Anchor: [NVDA, 2024, ITEM 7. MANAGEMENT'S DISCUSSION AND ANALYSIS]\\nContent:\\nCompute & Networking revenue increased 217% to $47.4 billion in fiscal year 2024, driven by customer demand for the NVIDIA HGX platform and Hopper architecture.\\n\\nUSER QUERY:\\nWhat drove NVIDIA's Compute & Networking revenue growth in FY2024?\"},\n",
    "            {\"role\": \"assistant\", \"content\": \"Compute & Networking revenue expanded 217% to $47.4 billion in fiscal 2024, driven by surging enterprise demand for the NVIDIA HGX platform and Hopper architecture [NVDA, 2024, ITEM 7. MANAGEMENT'S DISCUSSION AND ANALYSIS].\"}\n",
    "        ]\n",
    "    },\n",
    "    {\n",
    "        \"messages\": [\n",
    "            {\"role\": \"system\", \"content\": \"You are an elite, SEC-compliant Financial Document Intelligence AI Assistant. Rely strictly on provided excerpts and include mandatory [Ticker, Year, Section] citations. If disclosures are insufficient, refuse.\"},\n",
    "            {\"role\": \"user\", \"content\": \"EXCERPTS FROM VERIFIED SEC 10-K FILINGS:\\nCitation Anchor: [AAPL, 2024, ITEM 7. MANAGEMENT'S DISCUSSION AND ANALYSIS]\\nContent:\\nTotal net sales were $391.0 billion in fiscal 2024. Services revenue set an all-time record of $96.2 billion, up 13%.\\n\\nUSER QUERY:\\nWhat was Apple's total commercial airplane leasing revenue in 2024?\"},\n",
    "            {\"role\": \"assistant\", \"content\": \"The provided SEC 10-K disclosures are insufficient to confirm this information.\"}\n",
    "        ]\n",
    "    }\n",
    "]\n",
    "\n",
    "# Convert to HuggingFace Dataset\n",
    "dataset = Dataset.from_list(training_data)\n",
    "print(f\"Loaded {len(dataset)} instruction pairs.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Load Base Model in 4-bit NormalFloat (NF4)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n",
    "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n",
    "\n",
    "BASE_MODEL_NAME = \"mistralai/Mistral-7B-Instruct-v0.3\"\n",
    "\n",
    "# 4-bit NF4 Quantization Configuration\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type=\"nf4\",\n",
    "    bnb_4bit_use_double_quant=True,\n",
    "    bnb_4bit_compute_dtype=torch.bfloat16\n",
    ")\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL_NAME, use_fast=True)\n",
    "tokenizer.pad_token = tokenizer.eos_token\n",
    "tokenizer.padding_side = \"right\"\n",
    "\n",
    "print(\"Loading Mistral-7B base model into VRAM...\")\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    BASE_MODEL_NAME,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map=\"auto\",\n",
    "    trust_remote_code=True\n",
    ")\n",
    "\n",
    "model = prepare_model_for_kbit_training(model)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Configure LoRA Parameter-Efficient Adapters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "peft_config = LoraConfig(\n",
    "    r=16,\n",
    "    lora_alpha=32,\n",
    "    target_modules=[\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\"],\n",
    "    lora_dropout=0.05,\n",
    "    bias=\"none\",\n",
    "    task_type=\"CAUSAL_LM\"\n",
    ")\n",
    "\n",
    "model = get_peft_model(model, peft_config)\n",
    "model.print_trainable_parameters()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Execute QLoRA Training with SFTTrainer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import TrainingArguments\n",
    "from trl import SFTTrainer\n",
    "\n",
    "training_args = TrainingArguments(\n",
    "    output_dir=\"./checkpoints/mistral_7b_financial_lora\",\n",
    "    num_train_epochs=3,\n",
    "    per_device_train_batch_size=2,\n",
    "    gradient_accumulation_steps=4,\n",
    "    learning_rate=2e-4,\n",
    "    lr_scheduler_type=\"cosine\",\n",
    "    warmup_ratio=0.03,\n",
    "    logging_steps=5,\n",
    "    save_strategy=\"epoch\",\n",
    "    bf16=True,\n",
    "    optim=\"paged_adamw_8bit\",\n",
    "    report_to=\"none\"\n",
    ")\n",
    "\n",
    "trainer = SFTTrainer(\n",
    "    model=model,\n",
    "    train_dataset=dataset,\n",
    "    peft_config=peft_config,\n",
    "    dataset_text_field=\"messages\",\n",
    "    max_seq_length=2048,\n",
    "    tokenizer=tokenizer,\n",
    "    args=training_args\n",
    ")\n",
    "\n",
    "print(\"Starting fine-tuning run...\")\n",
    "trainer.train()\n",
    "\n",
    "# Save trained adapters\n",
    "trainer.model.save_pretrained(\"./checkpoints/mistral_7b_financial_lora\")\n",
    "tokenizer.save_pretrained(\"./checkpoints/mistral_7b_financial_lora\")\n",
    "print(\"Training complete! Adapter weights saved to ./checkpoints/mistral_7b_financial_lora\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Inference Test: Grounded Citation Verification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "test_prompt = \"\"\"<s>[INST] You are an elite, SEC-compliant Financial Document Intelligence AI Assistant. Rely strictly on provided excerpts and include mandatory [Ticker, Year, Section] citations. If disclosures are insufficient, refuse.\n",
    "\n",
    "EXCERPTS FROM VERIFIED SEC 10-K FILINGS:\n",
    "Citation Anchor: [NVDA, 2024, ITEM 1A. RISK FACTORS]\n",
    "Content:\n",
    "We rely on third-party foundry partners, primarily Taiwan Semiconductor Manufacturing Company (TSMC), to manufacture all of our semiconductor wafers.\n",
    "\n",
    "USER QUERY:\n",
    "What are NVIDIA's main semiconductor manufacturing risks in fiscal 2024? [/INST]\"\"\"\n",
    "\n",
    "inputs = tokenizer(test_prompt, return_tensors=\"pt\").to(\"cuda\")\n",
    "with torch.no_grad():\n",
    "    outputs = model.generate(**inputs, max_new_tokens=150, temperature=0.1)\n",
    "\n",
    "print(tokenizer.decode(outputs[0], skip_special_tokens=True))"
   ]
  }
